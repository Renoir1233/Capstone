                    </div>
                    <div class="form-group">
                        <label for="med-min-stock">Min Stock (Low Alert)</label>
                        <input type="number" id="med-min-stock" class="form-control-custom" min="1" placeholder="20" oninput="this.value = this.value.replace(/[^0-9]/g, '');">
                    </div>
                    <div class="form-group">
                        <label for="med-max-stock">Max Stock</label>
                        <input type="number" id="med-max-stock" class="form-control-custom" min="1" placeholder="100" oninput="this.value = this.value.replace(/[^0-9]/g, '');">
                    </div>
                </div>
                <div class="form-grid-3">
                    <div class="form-group">
                        <label for="med-crit-stock">Critical Stock Threshold</label>
                        <input type="number" id="med-crit-stock" class="form-control-custom" min="1" placeholder="10" oninput="this.value = this.value.replace(/[^0-9]/g, '');">
                    </div>
                    <div class="form-group">
                        <label for="med-unit">Unit</label>
                        <select id="med-unit" class="form-control-custom">
                            <option value="tablets">Tablets</option>
                            <option value="capsules">Capsules</option>
                            <option value="bottles">Bottles</option>
                            <option value="pcs">Pcs</option>
                            <option value="vials">Vials</option>
