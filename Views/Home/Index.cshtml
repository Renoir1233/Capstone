                            <option>Antihistamine</option>
                            <option>NSAID</option>
                            <option>Antacid</option>
                            <option>Bronchodilator</option>
                            <option>Topical</option>
                            <option>Vitamins &amp; Supplements</option>
                            <option>Others</option>
                        </select>
                    </div>
                </div>
                <div class="form-grid-3">
