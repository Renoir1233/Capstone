<!-- ==========================================
     MODAL: LOG VISIT OUTCOME
     ========================================== -->
<div id="log-visit-modal" class="modal-overlay">
    <div class="modal-content-custom" style="width: 500px; max-width: 95%; max-height: 90vh; display: flex; flex-direction: column;">
        <div class="modal-header-custom" style="flex-shrink: 0;">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#0a7a57,#059669);display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-clipboard-check" style="color:#fff;font-size:16px;"></i>
                </div>
                <div>
                    <span class="modal-title-custom" style="display:block;">Log Visit Outcome</span>
                    <span id="log-visit-patient-name" style="font-size:13px;color:#64748b;font-weight:500;"></span>
                </div>
            </div>
            <button class="btn-modal-close" onclick="app.closeLogVisitModal()">&times;</button>
        </div>
        <div class="modal-body-custom" style="overflow-y: auto; flex: 1; padding: 20px 24px;">
            <p style="font-size:13px;color:#64748b;margin-bottom:16px;">Select the outcome for this consultation visit:</p>

            <!-- Outcome Radio Cards -->
            <div style="display:flex;flex-direction:column;gap:8px;" id="outcome-options">

                <label class="outcome-card" for="outcome-fit">
                    <input type="radio" id="outcome-fit" name="visit-outcome" value="Fit to Work" checked>
                    <div class="outcome-card-inner">
                        <div class="outcome-icon" style="background:#ecfdf5;color:#059669;">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <div class="outcome-label">Fit to Work</div>
                            <div class="outcome-desc" style="font-size:11px;">Employee is cleared and can return to regular duties.</div>
                        </div>
                    </div>
                </label>

                <label class="outcome-card" for="outcome-sl">
                    <input type="radio" id="outcome-sl" name="visit-outcome" value="Sent Home (SL)">
                    <div class="outcome-card-inner">
                        <div class="outcome-icon" style="background:#fef2f2;color:#ef4444;">
                            <i class="fa-solid fa-house-medical"></i>
                        </div>
                        <div>
                            <div class="outcome-label">Sent Home (Sick Leave)</div>
                            <div class="outcome-desc" style="font-size:11px;">Employee is advised to rest at home. Sick leave recommended.</div>
                        </div>
                    </div>
                </label>

                <label class="outcome-card" for="outcome-rest">
                    <input type="radio" id="outcome-rest" name="visit-outcome" value="Rest Recommended">
                    <div class="outcome-card-inner">
                        <div class="outcome-icon" style="background:#fffbeb;color:#d97706;">
                            <i class="fa-solid fa-bed"></i>
                        </div>
                        <div>
                            <div class="outcome-label">Rest Recommended</div>
                            <div class="outcome-desc" style="font-size:11px;">Light duty or rest period advised before returning to full work.</div>
                        </div>
                    </div>
                </label>

                <label class="outcome-card" for="outcome-refer">
                    <input type="radio" id="outcome-refer" name="visit-outcome" value="Referred to Specialist">
                    <div class="outcome-card-inner">
                        <div class="outcome-icon" style="background:#eff6ff;color:#3b82f6;">
                            <i class="fa-solid fa-hospital-user"></i>
                        </div>
                        <div>
                            <div class="outcome-label">Referred to Specialist</div>
                            <div class="outcome-desc" style="font-size:11px;">Further evaluation by a specialist is required.</div>
                        </div>
                    </div>
                </label>
            </div>

            <!-- Notes -->
            <div class="form-group" style="margin-top:16px;">
                <label for="log-visit-notes" style="font-size:13px;font-weight:600;color:#374151;">Additional Notes (optional)</label>
                <input type="text" id="log-visit-notes" class="form-control-custom" placeholder="e.g. Additional observations or instructions" style="font-size:13px;">
            </div>

            <!-- Medicine/Prescription Section -->
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid #e2e8f0;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                    <i class="fa-solid fa-pills" style="color:#059669;font-size:14px;"></i>
                    <label style="font-size:13px;font-weight:600;color:#374151;margin:0;">Prescribe Medicine</label>
                </div>

                <div class="form-group" style="margin-bottom:10px;">
                    <select id="medicine-select-logvisit" class="form-control-custom" style="font-size:12px;padding:8px 12px;">
                        <option value="">-- Select Medicine --</option>
                    </select>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
                    <div class="form-group" style="margin:0;">
                        <input type="number" id="quantity-logvisit" class="form-control-custom" placeholder="Quantity" min="1" style="font-size:12px;padding:8px 12px;">
                    </div>
                    <div class="form-group" style="margin:0;">
                        <input type="text" id="dosage-logvisit" class="form-control-custom" placeholder="Dosage (e.g. 500mg)" style="font-size:12px;padding:8px 12px;">
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
                    <div class="form-group" style="margin:0;">
                        <select id="frequency-logvisit" class="form-control-custom" style="font-size:12px;padding:8px 12px;">
                            <option value="">Frequency</option>
                            <option value="Once daily">Once daily</option>
                            <option value="Twice daily">Twice daily</option>
                            <option value="Three times daily">Three times daily</option>
                            <option value="Four times daily">Four times daily</option>
                            <option value="Every 4 hours">Every 4 hours</option>
                            <option value="Every 6 hours">Every 6 hours</option>
                            <option value="Every 8 hours">Every 8 hours</option>
                            <option value="As needed">As needed</option>
                            <option value="Before meals">Before meals</option>
                            <option value="After meals">After meals</option>
                            <option value="At bedtime">At bedtime</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <input type="text" id="duration-logvisit" class="form-control-custom" placeholder="Duration (e.g. 7 days)" style="font-size:12px;padding:8px 12px;">
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:10px;">
                    <input type="text" id="instructions-logvisit" class="form-control-custom" placeholder="Special instructions (optional)" style="font-size:12px;padding:8px 12px;">
                </div>
                
                <input type="hidden" id="prescribed-by-logvisit" value="@User.Identity?.Name">

                <button type="button" class="btn-secondary-custom" onclick="QueueManager.addPrescriptionRow()" style="width:100%;font-size:12px;padding:8px 16px;">
                    <i class="fa-solid fa-plus"></i> Add to Prescription List
                </button>

                <!-- Prescription List -->
                <div id="prescription-list-logvisit" style="margin-top:12px;">
                    <p class="text-muted small" style="font-size:11px;margin:0;">No prescriptions added yet.</p>
                </div>
            </div>
        </div>
        <div class="modal-footer-custom" style="flex-shrink: 0;">
            <button type="button" class="btn-secondary-custom" onclick="app.closeLogVisitModal()">Cancel</button>
            <button type="button" class="btn-primary-custom" style="background:linear-gradient(135deg,#0a7a57,#059669);" onclick="app.confirmLogVisit()">
                <i class="fa-solid fa-clipboard-check"></i> Confirm &amp; Clear Patient
            </button>
        </div>
    </div>
</div>

<style>
