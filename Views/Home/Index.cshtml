            <div class="modal-footer-custom">
                <button type="button" class="btn-secondary-custom" onclick="app.closeAddMedicineModal()">Cancel</button>
                <button type="submit" class="btn-primary-custom" style="background-color: var(--primary-green);">
                    <i class="fa-solid fa-plus"></i> Add Medicine
                </button>
