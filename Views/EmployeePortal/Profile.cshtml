@model Capstone.Models.Employee
@{
    ViewData["Title"] = "My Profile";
    Layout = null;
}

<div style="max-width: 900px;">
    <form asp-action="UpdateProfile" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Personal Information Section -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
                <i class="fa-solid fa-id-card" style="color: #3b82f6; font-size: 20px;"></i>
                <h5 style="margin: 0; font-size: 18px; font-weight: 600; color: #1e293b;">Personal information</h5>
                <span style="margin-left: auto; font-size: 13px; color: #94a3b8;">Managed by HR</span>
            </div>

            <!-- Full Name & Employee Number Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Full name</label>
                    <input type="text" value="@Model.Name" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Employee number</label>
                    <input type="text" value="@Model.EmployeeNumber" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
            </div>

            <!-- Department & Position Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Department</label>
                    <input type="text" value="@Model.Department" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Position</label>
                    <input type="text" value="@(Model.Position ?? "Not set")" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #94a3b8;" />
                </div>
            </div>

            <!-- Age & Gender Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Age</label>
                    <input type="text" value="@Model.Age" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Gender</label>
                    <input type="text" value="@Model.Gender" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
            </div>

            <!-- Birthday Row -->
            <div style="margin-bottom: 0;">
                <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Birthday</label>
                <div style="max-width: calc(50% - 10px);">
                    <input type="text" value="@(Model.Birthday?.ToString("MMM dd, yyyy") ?? "N/A")" readonly style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: #f8fafc; color: #1e293b;" />
                </div>
            </div>
        </div>

        <!-- Government IDs Section -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
                <i class="fa-solid fa-id-card-clip" style="color: #3b82f6; font-size: 20px;"></i>
                <h5 style="margin: 0; font-size: 18px; font-weight: 600; color: #1e293b;">Government IDs</h5>
                <span style="margin-left: auto; font-size: 13px; color: #3b82f6;">You can edit this</span>
            </div>

            <!-- PhilHealth & SSS Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">PhilHealth ID</label>
                    <div style="position: relative;">
                        <input type="password" asp-for="PhilHealthId" value="@(string.IsNullOrWhiteSpace(Model.PhilHealthId) ? "" : Model.PhilHealthId)" placeholder="••••••••••••" style="width: 100%; padding: 12px 48px 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" id="philhealth-input" />
                        <button type="button" class="toggle-visibility-btn" data-target="philhealth-input" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94a3b8; cursor: pointer; padding: 8px; z-index: 10; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-regular fa-eye" style="font-size: 16px;"></i>
                        </button>
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">SSS ID</label>
                    <div style="position: relative;">
                        <input type="password" asp-for="SSSId" value="@(string.IsNullOrWhiteSpace(Model.SSSId) ? "" : Model.SSSId)" placeholder="•••••••••" style="width: 100%; padding: 12px 48px 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" id="sss-input" />
                        <button type="button" class="toggle-visibility-btn" data-target="sss-input" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94a3b8; cursor: pointer; padding: 8px; z-index: 10; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-regular fa-eye" style="font-size: 16px;"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- TIN & Pag-IBIG Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 0;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">TIN ID</label>
                    <div style="position: relative;">
                        <input type="password" asp-for="TINId" value="@(string.IsNullOrWhiteSpace(Model.TINId) ? "" : Model.TINId)" placeholder="••••••••••••" style="width: 100%; padding: 12px 48px 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" id="tin-input" />
                        <button type="button" class="toggle-visibility-btn" data-target="tin-input" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94a3b8; cursor: pointer; padding: 8px; z-index: 10; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-regular fa-eye" style="font-size: 16px;"></i>
                        </button>
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Pag-IBIG ID</label>
                    <div style="position: relative;">
                        <input type="password" asp-for="PagIbigId" value="@(string.IsNullOrWhiteSpace(Model.PagIbigId) ? "" : Model.PagIbigId)" placeholder="••••••••••••••" style="width: 100%; padding: 12px 48px 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" id="pagibig-input" />
                        <button type="button" class="toggle-visibility-btn" data-target="pagibig-input" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94a3b8; cursor: pointer; padding: 8px; z-index: 10; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-regular fa-eye" style="font-size: 16px;"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information Section -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
                <i class="fa-solid fa-phone" style="color: #3b82f6; font-size: 20px;"></i>
                <h5 style="margin: 0; font-size: 18px; font-weight: 600; color: #1e293b;">Contact information</h5>
                <span style="margin-left: auto; font-size: 13px; color: #3b82f6;">You can edit this</span>
            </div>

            <!-- Contact Number & Email Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Contact number</label>
                    <input type="text" asp-for="ContactNumber" placeholder="09171234567" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Email address</label>
                    <input type="email" asp-for="Email" placeholder="employee@unihealth.com" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" />
                </div>
            </div>

            <!-- Emergency Contact Row -->
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Emergency contact</label>
                <input type="text" asp-for="EmergencyContact" placeholder="Jane Doe - 09187654321" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b;" />
                <small style="display: block; margin-top: 6px; color: #94a3b8; font-size: 12px;">Format: name, then contact number</small>
            </div>

            <!-- Address Row -->
            <div style="margin-bottom: 0;">
                <label style="display: block; font-size: 13px; font-weight: 500; color: #64748b; margin-bottom: 8px;">Address</label>
                <textarea asp-for="Address" rows="2" placeholder="Complete Address" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 15px; background: white; color: #1e293b; resize: vertical;"></textarea>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" onclick="window.location.reload()" style="padding: 12px 28px; background: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                Cancel
            </button>
            <button type="submit" style="padding: 12px 28px; background: #3b82f6; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 1px 3px rgba(59, 130, 246, 0.3);">
                Save changes
            </button>
        </div>
    </form>
</div>
